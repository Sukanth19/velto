<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the database and settings to Google and to a new phone, but not
     device-only state (widget caches, whether Velto turned on Do Not Disturb), which
     lives in shared preferences and is left out by only including these two -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
